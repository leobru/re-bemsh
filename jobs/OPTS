# Макросы jobs/mall.mac - все команды ГС: интерпретация (mall), трасса
# ОТЛПЕЧ (mallo), компиляция (mallz) и вызовы из библиотеки (mallk, mallko)
mall: -l -c ПЕЧМАК jobs/mall.mac jobs/mall.prg
mallo: -l -c "ПЕЧМАК,ОТЛПЕЧ      1-9999" jobs/mall.mac jobs/mall.prg
mallz: -f -c "ЗПКОМП430040" jobs/mall.mac
mallzo: -f -c "ЗПКОМП430040,ОТЛПЕЧ      1-9999" jobs/mall.mac
mallk: -l -c "ЧТКОМП430040,ПЕЧМАК" jobs/mall.prg <mallz
mallko: -l -c "ЧТКОМП430040,ПЕЧМАК,ОТЛПЕЧ      1-9999" jobs/mall.prg <mallz
# Ошибки макромашины на тех же макросах: интерпретация и библиотека
merr: -l -c ПЕЧМАК jobs/mall.mac jobs/merr.mac jobs/merr.prg
merrz: -f -c ЗПКОМП430040 jobs/mall.mac jobs/merr.mac
merrk: -l -c "ЧТКОМП430040,ПЕЧМАК" jobs/merr.prg <merrz
merro: -l -c "ПЕЧМАК,ОТЛПЕЧ      1-325" jobs/mall.mac jobs/merr.mac jobs/merr.prg
# ОТЛПЕЧ с именем: ОШИБКИ - трасса макроса после ошибки, БПЕЧМО - без
# печати макроопределений, третья литера Ш - отладочная печать макроредактора
merrosh: -l -c "ПЕЧМАК,ОТЛПЕЧОШИБКИ1-325" jobs/mall.mac jobs/merr.mac jobs/merr.prg
mallb: -l -c "ПЕЧМАК,ОТЛПЕЧБПЕЧМО1-9999" jobs/mall.mac jobs/mall.prg
otlr: -l -c "ПЕЧМАК,ОТЛПЕЧ  Ш   1-99" jobs/rich.be
# Деление на ноль в SЕТА: авост, макромашина печатает без конца (BUGS.md)
div0: -l -c ПЕЧМАК !5
# &SNDX: переносы в десятичном счётчике вызовов (10, 100, 1000 вызовов)
msndx: -l -c ПЕЧМАК jobs/mall.mac jobs/msndx.prg
# Большая библиотека: вторая страница кода (зона +7), повторные определения
mbigz: -f -c ЗПКОМП430040 jobs/mall.mac jobs/merr.mac jobs/mall.mac
